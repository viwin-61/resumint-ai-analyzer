# Client variables are public and must never contain secrets.
VITE_API_BASE_URL=/api

# Server-only values. Keep these out of VITE_* variables.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Keep PDFs below Netlify's 4.5 MB effective binary request limit.
MAX_PDF_BYTES=4194304
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=reframe
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6-astra
SESSION_SECRET=replace_with_a_random_value_at_least_32_characters_long
# Demo credentials are only seeded when this is explicitly enabled in development.
ENABLE_DEMO_ACCOUNTS=false
# Required only for an opted-in development seed. Use unique local values.
DEMO_FREE_PASSWORD=
DEMO_BASIC_PASSWORD=
DEMO_PREMIUM_PASSWORD=
